#!/bin/sh
# Switch to workspace (profile only, no session loading by default)
# Usage: switch-workspace <workspace_name>

WORKSPACE="$1"
WORKSPACE_DIR="$HOME/.config/qutebrowser/workspace/$WORKSPACE"

if [ -z "$WORKSPACE" ]; then
    echo "message-error 'No workspace name provided'" >& "$QUTE_FIFO"
    exit 1
fi

if [ ! -d "$WORKSPACE_DIR" ]; then
    echo "message-error 'Workspace does not exist: $WORKSPACE'" >& "$QUTE_FIFO"
    exit 1
fi

setsid -f qutebrowser --basedir "$WORKSPACE_DIR"

echo "close" > "$QUTE_FIFO"
