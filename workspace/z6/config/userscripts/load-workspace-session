#!/bin/sh
# Load workspace session by number
# Usage: load-workspace-session <num> [session_name]
# num: 1=hacking, 2=study, 3=z6
# If no session_name, loads latest session

case "$1" in
    1) WORKSPACE="hacking" ;;
    2) WORKSPACE="study" ;;
    3) WORKSPACE="z6" ;;
    *) echo "message-error 'Invalid workspace number: $1'" >& "$QUTE_FIFO"; exit 1 ;;
esac

WORKSPACE_DIR="$HOME/.config/qutebrowser/workspace/$WORKSPACE"
SESSION="$2"

if [ ! -d "$WORKSPACE_DIR" ]; then
    echo "message-error 'Workspace does not exist: $WORKSPACE'" >& "$QUTE_FIFO"
    exit 1
fi

if [ -n "$SESSION" ]; then
    setsid -f qutebrowser --basedir "$WORKSPACE_DIR" -c "session-load '$SESSION'" 2>/dev/null
else
    latest=$(ls -t "$WORKSPACE_DIR"/*.yml 2>/dev/null | head -1)
    if [ -n "$latest" ]; then
        session_name=$(basename "$latest" .yml)
        setsid -f qutebrowser --basedir "$WORKSPACE_DIR" -c "session-load '$session_name'" 2>/dev/null
    else
        setsid -f qutebrowser --basedir "$WORKSPACE_DIR"
    fi
fi

echo "close" > "$QUTE_FIFO"